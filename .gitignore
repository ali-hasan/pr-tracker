# Build output and app logs
/target
/tracker.log

# Per-machine config — copy the .example files instead (see SETUP.md)
/.cargo/config.toml
/pr-review/config.sh

# Real per-user review history and locks — regenerated by the pipeline, not something to
# ship a stale/someone-else's copy of, or overwrite the next person's copy of when they pull.
/pr-review/RUNNING
/pr-review/run.log
/pr-review/run.log.prev
/pr-review/launchd.log
/pr-review/state.json
/pr-review/status.json
/pr-review/dismissed.json

# Generated review reports — proprietary PR content, and stale the moment someone else runs this.
/pr-reviews/

.DS_Store
